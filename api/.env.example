# Database connection string from Neon — use the POOLED (-pooler) host so
# PgBouncer absorbs connection churn from Neon's scale-to-zero.
DATABASE_URL=postgresql+psycopg://user:password@ep-project-pooler.neon.tech/dbname?sslmode=require

# Bearer token for API and MCP authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=your-secret-token-here

# Origin of the static dashboard site, for CORS (no wildcards)
CORS_ORIGIN=http://localhost:5173

# intervals.icu API credentials
# INTERVALS_API_KEY is the password for HTTP Basic auth (username is ignored)
INTERVALS_API_KEY=your-intervals-api-key

# intervals.icu athlete ID
INTERVALS_ATHLETE_ID=12345

# Number of days of history to sync nightly from intervals.icu (default: 3)
INTERVALS_SYNC_DAYS=3

# Timezone for meal date bucketing
TZ=Europe/Dublin

# Log level: INFO or DEBUG
LOG_LEVEL=INFO

# Optional: Sentry error tracking DSN
# SENTRY_DSN=

# MCP OAuth (docs/features/mcp_oauth.md) — optional. Leave all four unset to
# keep /mcp on the static APP_TOKEN bearer check exactly as today. Set all
# four together to enable Google OAuth login for Claude web/desktop as a
# custom connector; setting only some of them fails startup loudly.
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# MCP_ALLOWED_EMAIL=you@example.com
# MCP_PUBLIC_BASE_URL=https://your-deployed-app.onrender.com
